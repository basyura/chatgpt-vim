{
  "manifest_version": 3,
  "name": "ChatGPT Vim",
  "version": "0.1.0",
  "description": "ChatGPT を Vim 風のキーバインドで操作します。",
  "author": "basyura",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}
